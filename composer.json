{
    "name": "akqa-nz/silverstripe-userforms-webhooks",
    "description": "Post Silverstripe UserDefinedForm submissions to configurable webhooks with CMS-managed headers, conditions, and request logging",
    "type": "silverstripe-vendormodule",
    "license": "BSD-3-Clause",
    "keywords": [
        "silverstripe",
        "userforms",
        "webhook",
        "api"
    ],
    "homepage": "https://github.com/WPP-Public/akqa-nz-silverstripe-userforms-webhooks",
    "support": {
        "issues": "https://github.com/WPP-Public/akqa-nz-silverstripe-userforms-webhooks/issues"
    },
    "authors": [
        {
            "name": "AKQA",
            "homepage": "https://www.akqa.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "guzzlehttp/guzzle": "^7.9",
        "silverstripe/framework": "^6",
        "silverstripe/cms": "^6",
        "silverstripe/userforms": "^7",
        "symbiote/silverstripe-gridfieldextensions": "^5",
        "composer/installers": "^2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.3",
        "silverstripe/recipe-testing": "^4",
        "squizlabs/php_codesniffer": "^3.7"
    },
    "autoload": {
        "psr-4": {
            "Akqa\\SilverStripe\\UserFormsWebhooks\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Akqa\\SilverStripe\\UserFormsWebhooks\\Tests\\": "tests/"
        },
        "classmap": [
            "app/src/Page.php",
            "app/src/PageController.php"
        ]
    },
    "extra": {
        "branch-alias": {
            "dev-main": "2.x-dev"
        },
        "project-files-installed": [
            "behat.yml",
            "phpunit.xml.dist"
        ]
    },
    "scripts": {
        "lint": "phpcs src/ tests/",
        "lint-clean": "phpcbf src/ tests/",
        "test": "phpunit"
    },
    "prefer-stable": true,
    "minimum-stability": "dev",
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/vendor-plugin": true,
            "silverstripe/recipe-plugin": true,
            "phpstan/extension-installer": true
        }
    }
}
